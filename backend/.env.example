# ReConnect AI backend configuration. NEVER commit real secrets.
# Copy to backend/.env and fill in META_MODEL_API_KEY from the
# Meta Model API dashboard (https://ai.developer.meta.com).

# Base URL for the Meta Model API (OpenAI-compatible).
META_MODEL_API_BASE=https://api.meta.ai/v1
# Server-side only. Never expose to the frontend.
META_MODEL_API_KEY=paste-your-Muse2-key-here
# Model selection.
META_MODEL_TEXT=muse-spark-1.3
META_MODEL_VISION=muse-spark-1.3
# Request timeout in seconds.
META_MODEL_TIMEOUT=30
# Max accepted photo upload size in bytes (default 8 MiB).
DETECTIVE_MAX_PHOTO_BYTES=8388608

# --- ReConnect Shield ---
# Supabase Auth enables Bearer-token auth. The preferred setup is
# SUPABASE_URL alone: access tokens are verified against the project's
# current signing keys via JWKS (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
# SUPABASE_JWT_SECRET is the legacy HS256 fallback for older projects.
# When all are unset, Shield APIs return 503 unless SHIELD_DEMO_MODE=true
# (hackathon only).
SUPABASE_URL=https://pabgyswltfeynkwsuami.supabase.co
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SHIELD_DEMO_MODE=false
# Comma-separated admin user IDs (sub claims, or demo:NAME in demo mode).
SHIELD_ADMIN_IDS=
# Allowed frontend origins for CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173
# Shield rate limits.
SHIELD_REQUESTS_PER_DAY=10
SHIELD_MESSAGES_PER_HOUR=30
SHIELD_REPORTS_PER_DAY=5
SHIELD_PHOTOS_PER_DAY=20
SHIELD_DISCOVER_PER_HOUR=60
SHIELD_SCAMCHECK_PER_HOUR=60
